# --- Google Sign-In (website) --------------------------------------------
# Create a *separate* OAuth client in Google Cloud Console for this website:
# "APIs & Services" -> "Credentials" -> "Create Credentials" -> "OAuth client ID"
# -> Application type: "Web application".
# This is different from the extension's client ID in js/config.js, because a
# website login (server-side code flow) needs a client *secret* too, which a
# public client (like the extension) deliberately does not have.
# Authorized redirect URI to add in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google        (local dev)
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/google   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth session ------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev default; set to your real deployed URL in Vercel's env settings.
NEXTAUTH_URL=http://localhost:3000
